---
 pyproject.toml                     | 2 +-
 src/memstate/store/kuzu_adapter.py | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 8129334..28d3f3e 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -10,7 +10,7 @@ readme = "README.md"
 requires-python = ">=3.11"
 dependencies = [
     "tiktoken>=0.7.0",
-    "kuzu>=0.11.0",
+    "ladybug==0.21.2",
     "pydantic>=2.5",
     "pydantic-settings>=2.0",
     "fastapi>=0.109",
diff --git a/src/memstate/store/kuzu_adapter.py b/src/memstate/store/kuzu_adapter.py
index 8329631..1fb83b4 100644
--- a/src/memstate/store/kuzu_adapter.py
+++ b/src/memstate/store/kuzu_adapter.py
@@ -7,7 +7,7 @@ from pathlib import Path
 from types import SimpleNamespace
 from typing import Any
 
-import kuzu
+import ladybug as kuzu
 
 from memstate.config import Settings, get_settings
 from memstate.schema import SCHEMA_VERSION

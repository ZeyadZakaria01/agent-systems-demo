--- /dev/null
+++ b/tests/test_bitemporal_histories.py
@@ -0,0 +1,255 @@
+"""Step 2a: dated field histories, valid-time reads, keep-and-copy (ADR 0005)."""
+
+from __future__ import annotations
+
+import os
+import tempfile
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+from memstate.api.ui_api import ui_get_topic
+from memstate.core.executor import Executor
+from memstate.core.models import FieldWrite, IngestRequest, QueryRequest
+from memstate.datamodel.fields import new_history_entry
+from memstate.embeddings.base import HashEmbeddingProvider
+from memstate.schema import init_graph
+from memstate.store.graph_store import GraphStore
+from memstate.store.kuzu_adapter import KuzuGraph, clear_kuzu_graph_cache
+
+Y = 2025
+
+
+def d(month: int, day: int) -> str:
+    return datetime(Y, month, day, tzinfo=timezone.utc).isoformat()
+
+
+def dt(month: int, day: int) -> datetime:
+    return datetime(Y, month, day, tzinfo=timezone.utc)
+
+
+@pytest.fixture()
+def ex() -> Executor:
+    fd, path = tempfile.mkstemp(suffix=".kuzu")
+    os.close(fd)
+    clear_kuzu_graph_cache()
+    g = KuzuGraph(str(Path(path).resolve()))
+    init_graph(g)
+    return Executor(GraphStore(g), embedder=HashEmbeddingProvider(384))
+
+
+def make_topic(ex: Executor) -> str:
+    return ex.ingest(IngestRequest(placement="new_topic", title=f"t-{uuid.uuid4()}")).topic_id
+
+
+def write(ex: Executor, tid: str, value: str, valid_from=None, invalid_at=None) -> None:
+    ex.ingest(
+        IngestRequest(
+            placement="extend_topic",
+            topic_id=tid,
+            fields=[FieldWrite(name="f", value=value, valid_from=valid_from, invalid_at=invalid_at)],
+        )
+    )
+
+
+def rec(ex: Executor, tid: str):
+    return ex.store.get_field_with_history(tid, "f")
+
+
+def val_at(ex: Executor, tid: str, at: datetime):
+    e = rec(ex, tid).current_entry(at)
+    return e.value if e else None
+
+
+def test_undated_write_behaves_as_upstream(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "a")
+    e = rec(ex, tid).history[0]
+    assert e.valid_from == e.created_at and e.invalid_at is None and e.expired_at is None
+
+
+def test_ordinary_update_leaves_two_entries_and_no_end(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "a")
+    write(ex, tid, "b")
+    h = rec(ex, tid).history
+    assert [e.value for e in h] == ["b", "a"]
+    assert all(e.invalid_at is None and e.expired_at is None for e in h)
+    assert rec(ex, tid).current_entry().value == "b"
+
+
+def test_dated_entries_ordered_by_valid_from_and_late_older_value(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "pro", valid_from=d(10, 1))
+    write(ex, tid, "basic", valid_from=d(8, 1))  # arrives later, older
+    h = rec(ex, tid).history
+    assert [e.value for e in h] == ["pro", "basic"]
+    assert h[1].invalid_at is None and h[1].expired_at is None and len(h) == 2
+    assert val_at(ex, tid, dt(9, 1)) == "basic"
+    assert val_at(ex, tid, dt(10, 20)) == "pro"
+    assert val_at(ex, tid, dt(7, 1)) is None
+
+
+def test_equal_valid_from_later_recorded_wins(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "first", valid_from=d(6, 1))
+    write(ex, tid, "second", valid_from=d(6, 1))
+    assert val_at(ex, tid, dt(7, 1)) == "second"
+
+
+def test_future_dated_value_not_current_yet(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "basic", valid_from=d(6, 1))
+    write(ex, tid, "premium", valid_from=d(12, 1))
+    assert val_at(ex, tid, dt(11, 20)) == "basic"
+    assert val_at(ex, tid, dt(12, 5)) == "premium"
+
+
+def test_only_future_value_has_no_current(ex: Executor) -> None:
+    tid = make_topic(ex)
+    future = datetime(2999, 1, 1, tzinfo=timezone.utc).isoformat()
+    write(ex, tid, "premium", valid_from=future)
+    assert rec(ex, tid).current_entry() is None
+    out = ex.query(QueryRequest(q="x"))
+    f = [f for b in out.candidates if b.topic_id == tid for f in b.fields if f.name == "f"][0]
+    assert f.current is None
+    assert "current" in f.model_dump() and f.model_dump()["current"] is None
+
+
+def test_end_dated_value_stays_current_until_its_end(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "x", valid_from=d(9, 1), invalid_at=d(10, 1))
+    assert val_at(ex, tid, dt(9, 15)) == "x"
+    assert val_at(ex, tid, dt(10, 15)) is None

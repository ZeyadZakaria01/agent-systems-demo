+def test_retraction_keeps_and_copies(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "a", valid_from=d(1, 1))
+    write(ex, tid, "b", valid_from=d(2, 1))
+    b = rec(ex, tid).history[0]
+    cid = ex.store.retract_field_entry(tid, "f", b.id)
+    h = rec(ex, tid).history
+    assert len(h) == 3
+    orig = next(e for e in h if e.id == b.id)
+    copy = next(e for e in h if e.id == cid)
+    assert orig.expired_at and orig.corrected_by_entry_id == cid
+    assert copy.replaces_entry_id == b.id and copy.operation == "interval_corrected"
+    assert val_at(ex, tid, dt(3, 1)) == "a"

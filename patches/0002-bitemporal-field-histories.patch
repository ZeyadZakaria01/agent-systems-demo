@@ -98,6 +114,149 @@ def new_history_entry(
     )
 
 
+def utc_now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+_MIN_TIME = datetime.min.replace(tzinfo=timezone.utc)
+
+
+def parse_when(raw: str | None) -> datetime | None:
+    """Parse an ISO date or datetime (naive means UTC); None when it is not a date."""
+    if not raw or not isinstance(raw, str):
+        return None
+    s = raw.strip()
+    if s.endswith(("Z", "z")):
+        s = s[:-1] + "+00:00"
+    try:
+        d = datetime.fromisoformat(s)
+    except ValueError:
+        return None
+    return d if d.tzinfo else d.replace(tzinfo=timezone.utc)
+
+
+def effective_from(e: FieldHistoryEntry) -> datetime:
+    """Start of an entry's validity. A `valid_from` that is not a date keeps arrival order,
+    so the entry starts when it was written."""
+    return parse_when(e.valid_from) or parse_when(e.created_at) or _MIN_TIME
+
+
+def _validity_ends(live: list[FieldHistoryEntry]) -> dict[str, datetime | None]:
+    """End of each live entry's validity. An entry with its own `invalid_at` ends there; any
+    other entry is valid until the next such entry's start (end-dated entries layer over it)."""
+    ranked = sorted(enumerate(live), key=lambda ie: (effective_from(ie[1]), -ie[0]))
+    plain = [e for _, e in ranked if not parse_when(e.invalid_at)]
+    ends: dict[str, datetime | None] = {}
+    for i, e in enumerate(plain):
+        ends[e.id] = effective_from(plain[i + 1]) if i + 1 < len(plain) else None
+    for e in live:
+        own = parse_when(e.invalid_at)
+        if own:
+            ends[e.id] = own
+    return ends
+
+
+def believed_at(history: list[FieldHistoryEntry], recorded_at: datetime) -> list[FieldHistoryEntry]:
+    """The entries memory held at `recorded_at`: recorded by then (`created_at`) and not yet
+    expired then. Entries that have expired since are counted, shown as live."""
+    held: list[FieldHistoryEntry] = []
+    for e in history:
+        made = parse_when(e.created_at)
+        gone = parse_when(e.expired_at) if e.expired_at else None
+        if (made is not None and made > recorded_at) or (e.expired_at and gone is None):
+            continue
+        if gone is not None and gone <= recorded_at:
+            continue
+        held.append(e.model_copy(update={"expired_at": None}) if e.expired_at else e)
+    return held
+
+
+def resolve_valid(history: list[FieldHistoryEntry], at: datetime) -> FieldHistoryEntry | None:
+    """Value valid at `at`: expired entries are ignored; when several are valid the shorter
+    validity wins, then the later recorded one."""
+    live = [e for e in history if not e.expired_at]
+    ends = _validity_ends(live)
+    best: tuple[float, int] | None = None
+    best_e: FieldHistoryEntry | None = None
+    for idx, e in enumerate(live):
+        start = effective_from(e)
+        end = ends.get(e.id)
+        if start > at or (end is not None and end <= at):
+            continue
+        span = float("inf") if end is None else (end - start).total_seconds()
+        key = (span, idx)  # idx 0 is the latest recorded among equals
+        if best is None or key < best:
+            best, best_e = key, e
+    return best_e
+
+
+def _insert_ordered(history: list[FieldHistoryEntry], entry: FieldHistoryEntry) -> None:
+    """History is newest valid_from first; an equal start puts the later recorded first."""
+    start = effective_from(entry)
+    for i, h in enumerate(history):
+        if effective_from(h) <= start:
+            history.insert(i, entry)
+            return
+    history.append(entry)
+
+
+def _expire_and_copy(
+    history: list[FieldHistoryEntry],
+    old: FieldHistoryEntry,
+    *,
+    invalid_at: str | None,
+    now: str,
+) -> FieldHistoryEntry:
+    """Keep-and-copy (ADR 0005): mark `old` expired, append a corrected copy with the same
+    provenance and the new stored end (None = value retracted from its start)."""
+    copy = old.model_copy(
+        update={
+            "id": str(uuid.uuid4()),
+            "invalid_at": invalid_at if invalid_at is not None else old.valid_from,
+            "created_at": now,
+            "expired_at": None,
+            "operation": "interval_corrected",
+            "replaces_entry_id": old.id,
+            "corrected_by_entry_id": None,
+        }
+    )
+    old.expired_at = now
+    old.corrected_by_entry_id = copy.id
+    _insert_ordered(history, copy)
+    return copy
+
+
+def write_entry(history: list[FieldHistoryEntry], entry: FieldHistoryEntry, max_history: int) -> None:
+    """Append a write to `history` (mutates it). An ordinary update stores no end date on the
+    entry it replaces. A plain statement that starts inside an end-dated entry's stored
+    validity changes that stored end, so that entry is kept, expired and copied."""
+    now = utc_now_iso()
+    if not entry.created_at:
+        entry.created_at = now
+    if not entry.valid_from:
+        entry.valid_from = entry.created_at
+    start = parse_when(entry.valid_from)
+    if start is not None and not parse_when(entry.invalid_at):
+        for old in [e for e in history if not e.expired_at]:
+            end = parse_when(old.invalid_at)
+            old_start = parse_when(old.valid_from)
+            if end is not None and old_start is not None and old_start <= start < end:
+                _expire_and_copy(history, old, invalid_at=entry.valid_from, now=now)
+    _insert_ordered(history, entry)
+    del history[max_history:]
+
+
+def retract_entry(history: list[FieldHistoryEntry], entry_id: str, max_history: int) -> FieldHistoryEntry:
+    """Retract a value: keep it with `expired_at` and append a linked copy that is valid
+    nowhere (its end equals its start). Returns the copy."""
+    for old in history:
+        if old.id == entry_id and not old.expired_at:
+            copy = _expire_and_copy(history, old, invalid_at=None, now=utc_now_iso())
+            del history[max_history:]
+            return copy
+    raise ValueError(f"no live history entry: {entry_id}")
+
+
 class TopicFields(BaseModel):

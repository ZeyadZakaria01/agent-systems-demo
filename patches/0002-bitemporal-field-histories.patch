diff --git a/tests/test_bitemporal_histories.py b/tests/test_bitemporal_histories.py
new file mode 100644
index 0000000..6126b1b
--- /dev/null
+++ b/tests/test_bitemporal_histories.py
@@ -0,0 +1,320 @@
+"""Step 2: dated field histories, valid-time reads, keep-and-copy (ADR 0005), recorded-time reads."""
+
+from __future__ import annotations
+
+import os
+import tempfile
+import time
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+from memstate.api.ui_api import ui_get_topic
+from memstate.core.executor import Executor
+from memstate.core.models import FieldWrite, IngestRequest, QueryRequest
+from memstate.datamodel.fields import new_history_entry
+from memstate.embeddings.base import HashEmbeddingProvider
+from memstate.schema import init_graph
+from memstate.store.graph_store import GraphStore
+from memstate.store.kuzu_adapter import KuzuGraph, clear_kuzu_graph_cache
+
+Y = 2025
+
+
+def d(month: int, day: int) -> str:
+    return datetime(Y, month, day, tzinfo=timezone.utc).isoformat()
+
+
+def dt(month: int, day: int) -> datetime:
+    return datetime(Y, month, day, tzinfo=timezone.utc)
+
+
+@pytest.fixture()
+def ex() -> Executor:
+    fd, path = tempfile.mkstemp(suffix=".kuzu")
+    os.close(fd)
+    clear_kuzu_graph_cache()
+    g = KuzuGraph(str(Path(path).resolve()))
+    init_graph(g)
+    return Executor(GraphStore(g), embedder=HashEmbeddingProvider(384))
+
+
+def make_topic(ex: Executor) -> str:
+    return ex.ingest(IngestRequest(placement="new_topic", title=f"t-{uuid.uuid4()}")).topic_id
+
+
+def write(ex: Executor, tid: str, value: str, valid_from=None, invalid_at=None) -> None:
+    ex.ingest(
+        IngestRequest(
+            placement="extend_topic",
+            topic_id=tid,
+            fields=[FieldWrite(name="f", value=value, valid_from=valid_from, invalid_at=invalid_at)],
+        )
+    )
+
+
+def rec(ex: Executor, tid: str):
+    return ex.store.get_field_with_history(tid, "f")
+
+
+def val_at(ex: Executor, tid: str, at: datetime):
+    e = rec(ex, tid).current_entry(at)
+    return e.value if e else None
+
+
+def test_undated_write_behaves_as_upstream(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "a")
+    e = rec(ex, tid).history[0]
+    assert e.valid_from == e.created_at and e.invalid_at is None and e.expired_at is None
+
+
+def test_ordinary_update_leaves_two_entries_and_no_end(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "a")
+    write(ex, tid, "b")
+    h = rec(ex, tid).history
+    assert [e.value for e in h] == ["b", "a"]
+    assert all(e.invalid_at is None and e.expired_at is None for e in h)
+    assert rec(ex, tid).current_entry().value == "b"
+
+
+def test_dated_entries_ordered_by_valid_from_and_late_older_value(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "pro", valid_from=d(10, 1))
+    write(ex, tid, "basic", valid_from=d(8, 1))  # arrives later, older
+    h = rec(ex, tid).history
+    assert [e.value for e in h] == ["pro", "basic"]
+    assert h[1].invalid_at is None and h[1].expired_at is None and len(h) == 2
+    assert val_at(ex, tid, dt(9, 1)) == "basic"
+    assert val_at(ex, tid, dt(10, 20)) == "pro"
+    assert val_at(ex, tid, dt(7, 1)) is None
+
+
+def test_equal_valid_from_later_recorded_wins(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "first", valid_from=d(6, 1))
+    write(ex, tid, "second", valid_from=d(6, 1))
+    assert val_at(ex, tid, dt(7, 1)) == "second"
+
+
+def test_future_dated_value_not_current_yet(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "basic", valid_from=d(6, 1))
+    write(ex, tid, "premium", valid_from=d(12, 1))
+    assert val_at(ex, tid, dt(11, 20)) == "basic"
+    assert val_at(ex, tid, dt(12, 5)) == "premium"
+
+
+def test_only_future_value_has_no_current(ex: Executor) -> None:
+    tid = make_topic(ex)
+    future = datetime(2999, 1, 1, tzinfo=timezone.utc).isoformat()
+    write(ex, tid, "premium", valid_from=future)
+    assert rec(ex, tid).current_entry() is None
+    out = ex.query(QueryRequest(q="x"))
+    f = [f for b in out.candidates if b.topic_id == tid for f in b.fields if f.name == "f"][0]
+    assert f.current is None
+    assert "current" in f.model_dump() and f.model_dump()["current"] is None
+
+
+def test_end_dated_value_stays_current_until_its_end(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "x", valid_from=d(9, 1), invalid_at=d(10, 1))
+    assert val_at(ex, tid, dt(9, 15)) == "x"
+    assert val_at(ex, tid, dt(10, 15)) is None
+    assert len(rec(ex, tid).history) == 1
+
+
+def test_override_layers_over_base_and_lapses(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "$50", valid_from=d(9, 1))
+    write(ex, tid, "$80", valid_from=d(10, 1), invalid_at=d(11, 1))
+    h = rec(ex, tid).history
+    assert len(h) == 2 and all(e.expired_at is None for e in h)
+    assert val_at(ex, tid, dt(9, 20)) == "$50"
+    assert val_at(ex, tid, dt(10, 15)) == "$80"
+    assert val_at(ex, tid, dt(11, 5)) == "$50"
+
+
+def test_plain_statement_ends_override_with_keep_and_copy(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "$50", valid_from=d(9, 1))
+    write(ex, tid, "$80", valid_from=d(10, 1), invalid_at=d(11, 1))
+    write(ex, tid, "$100", valid_from=d(10, 10))
+    h = rec(ex, tid).history
+    assert len(h) == 4  # base, override (expired), corrected copy, $100
+    orig = next(e for e in h if e.value == "$80" and e.expired_at)
+    copy = next(e for e in h if e.operation == "interval_corrected")
+    assert copy.replaces_entry_id == orig.id and orig.corrected_by_entry_id == copy.id
+    assert copy.invalid_at == d(10, 10) and copy.provenance == orig.provenance
+    assert orig.invalid_at == d(11, 1)  # original untouched apart from expired_at
+    assert val_at(ex, tid, dt(11, 5)) == "$100"
+    assert val_at(ex, tid, dt(10, 15)) == "$100"  # plain statement ended the override
+    assert val_at(ex, tid, dt(10, 5)) == "$80"
+    assert val_at(ex, tid, dt(9, 20)) == "$50"
+
+
+def test_plain_statement_outside_override_changes_nothing_stored(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "$80", valid_from=d(10, 1), invalid_at=d(11, 1))
+    write(ex, tid, "$100", valid_from=d(12, 1))
+    h = rec(ex, tid).history
+    assert len(h) == 2 and all(e.expired_at is None for e in h)
+
+
+def test_retraction_keeps_and_copies(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "a", valid_from=d(1, 1))
+    write(ex, tid, "b", valid_from=d(2, 1))
+    b = rec(ex, tid).history[0]
+    cid = ex.store.retract_field_entry(tid, "f", b.id)
+    h = rec(ex, tid).history
+    assert len(h) == 3
+    orig = next(e for e in h if e.id == b.id)
+    copy = next(e for e in h if e.id == cid)
+    assert orig.expired_at and orig.corrected_by_entry_id == cid
+    assert copy.replaces_entry_id == b.id and copy.operation == "interval_corrected"
+    assert val_at(ex, tid, dt(3, 1)) == "a"
+
+
+def test_copies_count_toward_cap(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "base", valid_from=d(1, 1))
+    for i in range(4):
+        ex.store.append_field_history(
+            tid, "f", new_history_entry(value=i, valid_from=d(2, 1 + i), provenance="p"), max_history=3
+        )
+    assert len(rec(ex, tid).history) == 3
+
+
+def test_expired_hidden_unless_history_requested(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "$80", valid_from=d(10, 1), invalid_at=d(11, 1))
+    write(ex, tid, "$100", valid_from=d(10, 10))
+
+    def field(req: QueryRequest):
+        out = ex.query(req)
+        return [f for b in out.candidates if b.topic_id == tid for f in b.fields if f.name == "f"][0]
+
+    plain = field(QueryRequest(q="x"))
+    assert plain.current.value == "$100"
+    assert [v.value for v in plain.history] == ["$100"]
+    full = field(QueryRequest(q="x", explain=True))
+    assert any(v.expired_at for v in full.history) and len(full.history) == 3
+    asked = field(QueryRequest(q="x", valid_at=d(10, 5)))
+    assert asked.current.value == "$80" and asked.current.operation == "interval_corrected"
+    assert any(v.expired_at for v in asked.history)
+
+
+def test_valid_at_picks_value_and_raises_salience(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "old", valid_from=d(1, 1))
+    write(ex, tid, "new", valid_from=d(3, 1))
+    before = float(ex.store.get_topic(tid)["salience"])
+    out = ex.query(QueryRequest(q="x", valid_at=d(2, 1)))
+    f = [f for b in out.candidates if b.topic_id == tid for f in b.fields][0]
+    assert f.current.value == "old"
+    assert float(ex.store.get_topic(tid)["salience"]) > before
+
+
+def test_unparseable_valid_from_keeps_arrival_order(ex: Executor) -> None:
+    tid = make_topic(ex)
+    for i in range(3):
+        write(ex, tid, f"v{i}", valid_from=f"t{i}")
+    h = rec(ex, tid).history
+    assert [e.value for e in h] == ["v2", "v1", "v0"]
+    assert rec(ex, tid).current_entry().value == "v2"
+
+
+def test_bad_valid_at_is_rejected(ex: Executor) -> None:
+    make_topic(ex)
+    with pytest.raises(ValueError):
+        ex.query(QueryRequest(q="x", valid_at="not a date"))
+
+
+def test_ui_topic_read_returns_current(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "a", valid_from=d(1, 1))
+    future = datetime(2999, 1, 1, tzinfo=timezone.utc).isoformat()
+    ex.ingest(
+        IngestRequest(
+            placement="extend_topic", topic_id=tid, fields=[FieldWrite(name="g", value="z", valid_from=future)]
+        )
+    )
+    out = ui_get_topic(tid, store=ex.store)
+    assert out["fields"]["f"]["current"]["value"] == "a"
+    assert "current" in out["fields"]["g"] and out["fields"]["g"]["current"] is None
+
+
+def test_openapi_declares_dates() -> None:
+    from memstate.api.main import app
+
+    schemas = app.openapi()["components"]["schemas"]
+    assert {"valid_from", "invalid_at"} <= set(schemas["FieldWrite"]["properties"])
+    assert {"valid_at", "recorded_at"} <= set(schemas["QueryRequest"]["properties"])
+
+
+def as_of_topic(ex: Executor) -> str:
+    """The as-of probe: Jan 5 "April 20" (true from Jan 5); Feb 15 "May 1" (true from Feb 1)."""
+    tid = make_topic(ex)
+    for value, valid, recorded in (("April 20", d(1, 5), d(1, 5)), ("May 1", d(2, 1), d(2, 15))):
+        ex.store.append_field_history(
+            tid, "f", new_history_entry(value=value, valid_from=valid, created_at=recorded, provenance="p"), max_history=50
+        )
+    return tid
+
+
+def ask(ex: Executor, tid: str, **dates):
+    out = ex.query(QueryRequest(q="x", **dates))
+    f = [f for b in out.candidates if b.topic_id == tid for f in b.fields if f.name == "f"][0]
+    return f
+
+
+def test_believed_on_feb_10_is_april_20_with_nothing_expired(ex: Executor) -> None:
+    tid = as_of_topic(ex)
+    assert all(e.expired_at is None for e in rec(ex, tid).history)
+    assert ask(ex, tid, valid_at=d(2, 10)).current.value == "May 1"  # true on Feb 10
+    f = ask(ex, tid, recorded_at=d(2, 10))  # believed on Feb 10
+    assert f.current.value == "April 20"
+    assert len(f.history) == 2  # a recorded_at read is a history request
+    assert ask(ex, tid).current.value == "May 1"
+
+
+def test_recorded_at_combines_with_valid_at(ex: Executor) -> None:
+    tid = as_of_topic(ex)
+    assert ask(ex, tid, recorded_at=d(2, 10), valid_at=d(2, 10)).current.value == "April 20"  # not yet told
+    assert ask(ex, tid, recorded_at=d(3, 1), valid_at=d(2, 10)).current.value == "May 1"
+    assert ask(ex, tid, recorded_at=d(3, 1), valid_at=d(1, 20)).current.value == "April 20"
+    assert ask(ex, tid, recorded_at=d(1, 1)).current is None  # nothing recorded yet
+    assert ask(ex, tid, recorded_at=d(1, 10), valid_at=d(1, 7)).current.value == "April 20"
+
+
+def test_recorded_at_counts_entries_that_have_since_expired(ex: Executor) -> None:
+    tid = make_topic(ex)
+    write(ex, tid, "$50", valid_from=d(9, 1))
+    write(ex, tid, "$80", valid_from=d(10, 1), invalid_at=d(11, 1))
+    time.sleep(0.05)
+    before = datetime.now(timezone.utc).isoformat()
+    time.sleep(0.05)
+    write(ex, tid, "$100", valid_from=d(10, 10))  # expires $80 and appends its corrected copy
+    assert any(e.expired_at for e in rec(ex, tid).history)
+    assert ask(ex, tid, recorded_at=before, valid_at=d(10, 15)).current.value == "$80"  # then believed
+    assert ask(ex, tid, valid_at=d(10, 15)).current.value == "$100"  # believed now
+    after = datetime.now(timezone.utc).isoformat()
+    assert ask(ex, tid, recorded_at=after, valid_at=d(10, 15)).current.value == "$100"
+    assert ask(ex, tid, recorded_at=after, valid_at=d(10, 5)).current.value == "$80"
+
+
+def test_recorded_at_read_raises_salience(ex: Executor) -> None:
+    tid = as_of_topic(ex)
+    before = float(ex.store.get_topic(tid)["salience"])
+    ask(ex, tid, recorded_at=d(2, 10))
+    assert float(ex.store.get_topic(tid)["salience"]) > before
+
+
+def test_bad_recorded_at_is_rejected(ex: Executor) -> None:
+    make_topic(ex)
+    with pytest.raises(ValueError):
+        ex.query(QueryRequest(q="x", recorded_at="not a date"))

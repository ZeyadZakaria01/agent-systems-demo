+"""Step 2c: the chat request's `reference_time` (system prompt, default valid_from, as-of reads, provenance)."""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import tempfile
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+from fastapi import HTTPException
+
+from memstate.config import Settings
+from memstate.datamodel.fields import (
+    MEMSTATE_NESTED_BUNDLE,
+    MEMSTATE_NESTED_FIELDS_KEY,
+    TopicField,
+    new_history_entry,
+)
+from memstate.llm import chat_api
+from memstate.llm.chat_api import ChatBody, _execute_chat_body
+from memstate.llm.tool_runner import MemoryToolRunner
+from memstate.llm.tools_schema import tools_for_intent_route
+from memstate.schema import init_graph
+from memstate.store.graph_store import GraphStore
+from memstate.store.kuzu_adapter import KuzuGraph, clear_kuzu_graph_cache
+
+OCT6 = datetime(2026, 10, 6, tzinfo=timezone.utc)
+OCT20 = datetime(2026, 10, 20, tzinfo=timezone.utc)
+
+
+def _store() -> GraphStore:
+    fd, path = tempfile.mkstemp(suffix=".kuzu")
+    os.close(fd)
+    clear_kuzu_graph_cache()
+    g = KuzuGraph(str(Path(path).resolve()))
+    init_graph(g)
+    return GraphStore(g)
+
+
+def _topic(store: GraphStore) -> str:
+    tid = str(uuid.uuid4())
+    store.create_topic(tid, title="Person", summary=None, salience=1.0, archived=False, embedding=None)
+    return tid
+
+
+def _append(runner: MemoryToolRunner, tid: str, value: str, **extra) -> dict:
+    return runner.execute("memory_append_field", {"topic_id": tid, "field_name": "job", "value": value, **extra})
+
+
+def _entry(store: GraphStore, tid: str, i: int = 0):
+    return store.get_field_with_history(tid, "job").history[i]
+
+
+def test_default_valid_from_is_the_reference_time_and_provenance_records_it() -> None:
+    store = _store()
+    tid = _topic(store)
+    assert _append(MemoryToolRunner(store, reference_time=OCT6), tid, "new job")["ok"] is True
+    e = _entry(store, tid)
+    assert e.valid_from == OCT6.isoformat()
+    assert e.provenance == f"llm (reference_time {OCT6.isoformat()})"
+    assert e.created_at != OCT6.isoformat()  # recorded time is still the wall clock
+
+
+def test_model_filled_valid_from_wins_over_the_reference_time() -> None:
+    store = _store()
+    tid = _topic(store)
+    r = MemoryToolRunner(store, reference_time=OCT6)
+    assert _append(r, tid, "new job", valid_from="2026-09-22")["ok"] is True
+    e = _entry(store, tid)
+    assert e.valid_from == "2026-09-22"
+    assert OCT6.isoformat() in e.provenance
+
+
+def test_valid_from_that_is_not_a_date_is_rejected_and_nothing_is_stored() -> None:
+    store = _store()
+    tid = _topic(store)
+    out = _append(MemoryToolRunner(store, reference_time=OCT6), tid, "x", valid_from="two weeks ago")
+    assert out["ok"] is False and "valid_from" in out["error"]
+    assert store.get_field_with_history(tid, "job") is None
+
+
+def test_without_a_reference_time_the_runner_behaves_as_before() -> None:
+    store = _store()
+    tid = _topic(store)
+    _append(MemoryToolRunner(store), tid, "x")
+    e = _entry(store, tid)
+    assert e.provenance == "llm"
+    assert datetime.fromisoformat(e.valid_from).year >= 2026
+
+
+def _two_dated_jobs(store: GraphStore, tid: str) -> None:
+    for value, start in (("old job", "2026-01-01T00:00:00+00:00"), ("new job", "2026-09-22T00:00:00+00:00")):
+        store.append_field_history(tid, "job", new_history_entry(value=value, valid_from=start, provenance="t"))
+
+
+def test_reads_are_as_of_the_reference_time() -> None:
+    store = _store()
+    tid = _topic(store)
+    _two_dated_jobs(store, tid)
+    now_runner = MemoryToolRunner(store)
+    before = MemoryToolRunner(store, reference_time=datetime(2026, 8, 1, tzinfo=timezone.utc))
+    after = MemoryToolRunner(store, reference_time=OCT20)
+    args = {"topic_id": tid, "field_name": "job"}
+    assert now_runner.execute("memory_get_field", args)["field"]["value"] == "new job"
+    assert before.execute("memory_get_field", args)["field"]["value"] == "old job"
+    assert after.execute("memory_get_field", args)["field"]["value"] == "new job"
+    assert before.execute("memory_get_field_history", args)["field"]["value"] == "old job"
+    cur = before.execute("memory_get_topic_schema", {"topic_id": tid, "detail": "current"})
+    assert cur["fields"]["job"]["value"] == "old job"
+    topic = before.execute("memory_get_topic", {"topic_id": tid})
+    assert topic["topic"]["fields"]["job"]["value"] == "old job"
+    # the history stays whole: the as-of view only picks the current value
+    assert topic["topic"]["fields"]["job"]["history_count"] == 2
+
+
+def test_entry_that_starts_after_the_reference_time_is_not_current_yet() -> None:
+    store = _store()
+    tid = _topic(store)
+    r = MemoryToolRunner(store, reference_time=OCT6)
+    _append(r, tid, "future", valid_from="2026-12-01")
+    assert r.execute("memory_get_field", {"topic_id": tid, "field_name": "job"})["field"]["value"] is None
+
+
+def test_tool_schema_offers_valid_from() -> None:
+    tool = next(t for t in tools_for_intent_route("ingest") if t["function"]["name"] == "memory_append_field")
+    assert "valid_from" in tool["function"]["parameters"]["properties"]
+    assert "valid_from" not in tool["function"]["parameters"]["required"]
+
+
+class _Fake:
+    """Stands in for the Ollama loop: records the system prompt, runs the scripted tool calls."""
+
+    def __init__(self, calls):
+        self.calls = calls
+        self.system_prompt = None
+        self.results = []
+
+    async def __call__(self, *, runner, system_prompt, **_):
+        self.system_prompt = system_prompt
+        self.results = [runner.execute(n, a) for n, a in self.calls]
+        return "ok", [], "fake"
+
+
+def _chat(monkeypatch, store, body, fake) -> dict:
+    monkeypatch.setattr(chat_api, "run_ollama_chat", fake)
+    return asyncio.run(_execute_chat_body(body, store, Settings()))
+
+
+def _body(**kw) -> ChatBody:
+    return ChatBody(
+        messages=[{"role": "user", "content": "I started my new job two weeks ago"}],
+        intent_override="both",
+        study_ingest=False,
+        **kw,
+    )
+
+
+def test_chat_request_carries_reference_time_into_prompt_default_valid_from_and_provenance(monkeypatch) -> None:
+    store = _store()
+    tid = _topic(store)
+    fake = _Fake([("memory_append_field", {"topic_id": tid, "field_name": "job", "value": "new job"})])
+    _chat(monkeypatch, store, _body(reference_time="2026-10-06"), fake)
+    assert OCT6.isoformat() in fake.system_prompt
+    e = _entry(store, tid)
+    assert e.valid_from == OCT6.isoformat()
+    assert OCT6.isoformat() in e.provenance
+
+
+def test_chat_request_reads_run_as_of_its_reference_time(monkeypatch) -> None:
+    store = _store()
+    tid = _topic(store)
+    _two_dated_jobs(store, tid)
+    fake = _Fake([("memory_get_field", {"topic_id": tid, "field_name": "job"})])
+    _chat(monkeypatch, store, _body(reference_time="2026-08-01"), fake)
+    assert fake.results[0]["field"]["value"] == "old job"
+
+
+def test_chat_reference_time_defaults_to_now(monkeypatch) -> None:
+    store = _store()
+    tid = _topic(store)
+    fake = _Fake([("memory_append_field", {"topic_id": tid, "field_name": "job", "value": "x"})])
+    t0 = datetime.now(timezone.utc)
+    _chat(monkeypatch, store, _body(), fake)
+    e = _entry(store, tid)
+    stamp = datetime.fromisoformat(e.valid_from)
+    assert t0 <= stamp <= datetime.now(timezone.utc)
+    assert e.valid_from in fake.system_prompt and e.valid_from in e.provenance
+
+
+def test_chat_rejects_a_reference_time_that_is_not_a_date(monkeypatch) -> None:
+    store = _store()
+    with pytest.raises(HTTPException) as exc:
+        _chat(monkeypatch, store, _body(reference_time="last tuesday"), _Fake([]))
+    assert exc.value.status_code == 400
+
+
+def _bundle(store: GraphStore, tid: str) -> None:
+    """A json field `Address` whose nested bundle holds `city`: the bundle says Cairo until 2026-09-01, Giza from then."""
+    for city, start in (("Cairo", "2026-01-01T00:00:00+00:00"), ("Giza", "2026-09-01T00:00:00+00:00")):
+        inner = TopicField(field_type="string", history=[new_history_entry(value=city, valid_from=start, provenance="t")])
+        value = {MEMSTATE_NESTED_BUNDLE: True, MEMSTATE_NESTED_FIELDS_KEY: {"city": inner.model_dump()}}
+        store.append_field_history(
+            tid, "Address", new_history_entry(value=value, valid_from=start, provenance="t"), field_type="json"
+        )
+
+
+def test_reads_of_a_nested_field_by_its_inner_name_are_as_of_the_reference_time() -> None:
+    store = _store()
+    tid = _topic(store)
+    _bundle(store, tid)
+    args = {"topic_id": tid, "field_name": "city"}
+    before = MemoryToolRunner(store, reference_time=datetime(2026, 8, 1, tzinfo=timezone.utc))
+    assert MemoryToolRunner(store).execute("memory_get_field", args)["field"]["value"] == "Giza"
+    assert before.execute("memory_get_field", args)["field"]["value"] == "Cairo"
+
+
+def _snapshot_values(out: dict) -> dict:
+    (node,) = out["data"]["nodes"]
+    return {f["name"]: f["current_value"] for f in node["fields"]}
+
+
+def test_the_graph_snapshot_is_as_of_the_reference_time() -> None:
+    store = _store()
+    tid = _topic(store)
+    _two_dated_jobs(store, tid)
+    now = MemoryToolRunner(store).execute("memory_graph_snapshot", {})
+    before = MemoryToolRunner(store, reference_time=datetime(2026, 8, 1, tzinfo=timezone.utc))
+    assert _snapshot_values(now) == {"job": "new job"}
+    assert _snapshot_values(before.execute("memory_graph_snapshot", {})) == {"job": "old job"}

diff --git a/src/memstate/core/executor.py b/src/memstate/core/executor.py
index a0438ca..9f77061 100644
--- a/src/memstate/core/executor.py
+++ b/src/memstate/core/executor.py
@@ -352,11 +352,22 @@ class Executor:
         return QueryResponse(query=req.q, candidates=bundles, summary_text="\n".join(lines))
 
     def run_revise_duplicates(self) -> list[str]:
+        """Merge same-title topics one pair at a time, looking for duplicates again after each merge
+        (a dropped topic can be part of other pairs)."""
         actions: list[str] = []
-        for title, id_a, id_b in self._store.find_duplicate_titles():
+        dropped: set[str] = set()
+        while True:
+            pairs = [p for p in self._store.find_duplicate_titles() if p[2] not in dropped]
+            if not pairs:
+                return actions
+            title, id_a, id_b = pairs[0]
             self._store.merge_topics(keep_id=id_a, drop_id=id_b)
+            dropped.add(id_b)
+            self._store.append_topic_history(
+                id_a,
+                {"ts": _utc_iso(), "kind": "merged", "detail": {"from_topic_id": id_b, "title": title}},
+            )
             actions.append(f"merged:{id_b}->:{id_a}:{title}")
-        return actions
 
     def run_forget_low_salience(self) -> list[str]:
         rows = self._store.list_topics_for_embedding_scan(include_archived=False)
diff --git a/src/memstate/datamodel/fields.py b/src/memstate/datamodel/fields.py
index 15da2ca..ee9f1fd 100644
--- a/src/memstate/datamodel/fields.py
+++ b/src/memstate/datamodel/fields.py
@@ -257,6 +257,27 @@ def retract_entry(history: list[FieldHistoryEntry], entry_id: str, max_history:
     raise ValueError(f"no live history entry: {entry_id}")
 
 
+def merge_histories(
+    kept: list[FieldHistoryEntry],
+    dropped: list[FieldHistoryEntry],
+    dropped_topic_id: str,
+    max_history: int,
+) -> None:
+    """Interleave a dropped topic's history into the kept topic's by valid time (mutates `kept`).
+
+    Every dropped entry arrives tagged `operation="merged"` and `merged_from_topic_id`, with its value,
+    dates, provenance and recorded time unchanged. A live entry goes in like a write (`write_entry`), so a
+    kept entry whose stored end it now cuts short is expired and copied; an already expired entry is only
+    carried over, still expired."""
+    for old in sorted(dropped, key=effective_from):
+        entry = old.model_copy(update={"operation": "merged", "merged_from_topic_id": dropped_topic_id})
+        if entry.expired_at:
+            _insert_ordered(kept, entry)
+        else:
+            write_entry(kept, entry, max_history)
+    del kept[max_history:]
+
+
 class TopicFields(BaseModel):
     """Map field name -> TopicField."""
 

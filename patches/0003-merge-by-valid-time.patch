diff --git a/tests/test_merge_by_valid_time.py b/tests/test_merge_by_valid_time.py
new file mode 100644
index 0000000..9861e32
--- /dev/null
+++ b/tests/test_merge_by_valid_time.py
@@ -0,0 +1,170 @@
+"""Step 3: the Reasoner's duplicate merge interleaves both topics' histories by valid time."""
+
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+
+from memstate.core.executor import Executor
+from memstate.core.models import FieldWrite, IngestRequest
+from memstate.embeddings.base import HashEmbeddingProvider
+from memstate.schema import init_graph
+from memstate.store.graph_store import GraphStore
+from memstate.store.kuzu_adapter import KuzuGraph, clear_kuzu_graph_cache
+
+TITLE = "Vendor Contract"
+
+
+def dt(y: int, m: int, d: int) -> datetime:
+    return datetime(y, m, d, tzinfo=timezone.utc)
+
+
+def iso(y: int, m: int, d: int) -> str:
+    return dt(y, m, d).isoformat()
+
+
+@pytest.fixture()
+def ex() -> Executor:
+    fd, path = tempfile.mkstemp(suffix=".kuzu")
+    os.close(fd)
+    clear_kuzu_graph_cache()
+    g = KuzuGraph(str(Path(path).resolve()))
+    init_graph(g)
+    return Executor(GraphStore(g), embedder=HashEmbeddingProvider(384))
+
+
+def topic(ex: Executor, title: str = TITLE) -> str:
+    return ex.ingest(IngestRequest(placement="new_topic", title=title)).topic_id
+
+
+def write(ex: Executor, tid: str, value, *, valid_from=None, invalid_at=None, provenance="api", field="f") -> None:
+    ex.ingest(IngestRequest(placement="extend_topic", topic_id=tid, fields=[
+        FieldWrite(name=field, value=value, valid_from=valid_from, invalid_at=invalid_at, provenance=provenance)]))
+
+
+def pair(ex: Executor) -> tuple[str, str]:
+    """(kept, dropped): two same-title topics; the merge keeps the lower id."""
+    a, b = sorted([topic(ex), topic(ex)])
+    return a, b
+
+
+def rec(ex: Executor, tid: str, field: str = "f"):
+    return ex.store.get_field_with_history(tid, field)
+
+
+def val_at(ex: Executor, tid: str, at: datetime):
+    e = rec(ex, tid).current_entry(at)
+    return e.value if e else None
+
+
+def events(ex: Executor, tid: str) -> list[dict]:
+    row = ex.store.get_topic(tid)
+    return json.loads(row["topic_history_json"])
+
+
+def test_merge_interleaves_both_histories_by_valid_time(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, keep, "a1", valid_from=iso(2025, 1, 1))
+    write(ex, keep, "a3", valid_from=iso(2025, 3, 1))
+    write(ex, drop, "b2", valid_from=iso(2025, 2, 1))
+    write(ex, drop, "b4", valid_from=iso(2025, 4, 1))
+    actions = ex.run_revise_duplicates()
+    assert actions == [f"merged:{drop}->:{keep}:{TITLE}"]
+    assert ex.store.get_topic(drop) is None
+    assert [e.value for e in rec(ex, keep).history] == ["b4", "a3", "b2", "a1"]
+    assert [val_at(ex, keep, dt(2025, m, 15)) for m in (1, 2, 3, 4)] == ["a1", "b2", "a3", "b4"]
+
+
+def test_dated_merge_today_reads_april_20_and_both_values_stay(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, keep, "April 20", valid_from=iso(2025, 1, 5), provenance="pm-email")
+    write(ex, drop, "March 15", valid_from=iso(2024, 12, 1), provenance="kickoff-notes")
+    ex.run_revise_duplicates()
+    r = rec(ex, keep)
+    assert r.current_entry().value == "April 20"
+    assert {(e.value, e.provenance) for e in r.history} == {("April 20", "pm-email"), ("March 15", "kickoff-notes")}
+    assert val_at(ex, keep, dt(2024, 12, 20)) == "March 15"
+
+
+def test_dropped_entries_are_tagged_and_keep_provenance(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, keep, "new", valid_from=iso(2025, 2, 1), provenance="p-keep")
+    write(ex, drop, "old", valid_from=iso(2025, 1, 1), provenance="p-drop")
+    ex.run_revise_duplicates()
+    by_value = {e.value: e for e in rec(ex, keep).history}
+    merged = by_value["old"]
+    assert merged.operation == "merged" and merged.merged_from_topic_id == drop
+    assert merged.provenance == "p-drop" and merged.valid_from == iso(2025, 1, 1)
+    assert by_value["new"].operation != "merged" and not getattr(by_value["new"], "merged_from_topic_id", None)
+
+
+def test_a_field_only_the_dropped_topic_has_moves_over_tagged(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, keep, "x", field="g")
+    write(ex, drop, "y", field="f", provenance="p-drop")
+    ex.run_revise_duplicates()
+    e = rec(ex, keep).history[0]
+    assert (e.value, e.provenance, e.operation, e.merged_from_topic_id) == ("y", "p-drop", "merged", drop)
+
+
+def test_an_end_dated_entry_whose_validity_changes_is_expired_and_copied(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, keep, "budget", valid_from=iso(2025, 1, 1), invalid_at=iso(2025, 3, 1))
+    write(ex, drop, "override", valid_from=iso(2025, 2, 1))
+    ex.run_revise_duplicates()
+    h = rec(ex, keep).history
+    old = next(e for e in h if e.value == "budget" and e.expired_at)
+    copy = next(e for e in h if e.value == "budget" and not e.expired_at)
+    assert copy.replaces_entry_id == old.id and old.corrected_by_entry_id == copy.id
+    assert copy.invalid_at == iso(2025, 2, 1)
+    assert val_at(ex, keep, dt(2025, 1, 15)) == "budget" and val_at(ex, keep, dt(2025, 2, 15)) == "override"
+
+
+def test_entries_whose_validity_does_not_change_are_not_copied(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, keep, "a", valid_from=iso(2025, 1, 1))
+    write(ex, drop, "b", valid_from=iso(2025, 2, 1))
+    ex.run_revise_duplicates()
+    assert all(e.expired_at is None for e in rec(ex, keep).history)
+    assert len(rec(ex, keep).history) == 2
+
+
+def test_the_survivor_gets_one_merged_event(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, drop, "b")
+    before = len(events(ex, keep))
+    ex.run_revise_duplicates()
+    new = events(ex, keep)[before:]
+    assert [e["kind"] for e in new] == ["merged"]
+    assert new[0]["detail"]["from_topic_id"] == drop
+
+
+def test_an_archived_duplicate_is_skipped(ex: Executor) -> None:
+    keep, drop = pair(ex)
+    write(ex, keep, "a")
+    write(ex, drop, "b")
+    ex.store.update_topic_meta(keep, archived=True)
+    assert ex.run_revise_duplicates() == []
+    assert ex.store.get_topic(keep) is not None and ex.store.get_topic(drop) is not None
+    assert [e.value for e in rec(ex, keep).history] == ["a"]
+
+
+def test_three_duplicates_merge_into_one_topic_with_every_value(ex: Executor) -> None:
+    ids = sorted(topic(ex) for _ in range(3))
+    for i, tid in enumerate(ids):
+        write(ex, tid, f"v{i}", valid_from=iso(2025, 1 + i, 1), provenance=f"p{i}")
+    actions = ex.run_revise_duplicates()
+    assert len(actions) == 2
+    alive = [t for t in ids if ex.store.get_topic(t) is not None]
+    assert alive == [ids[0]]
+    r = rec(ex, ids[0])
+    assert [e.value for e in r.history] == ["v2", "v1", "v0"]
+    assert {e.provenance for e in r.history} == {"p0", "p1", "p2"}
+    assert r.current_entry().value == "v2"
+    assert [e["kind"] for e in events(ex, ids[0])].count("merged") == 2

#!/bin/sh
# Guardrails for every clone and worktree (enabled by: git config core.hooksPath .githooks).
# 1. The report is edited only on `main` (single source of truth; a branch's copy goes stale).
# 2. Wayfinder map lines added or changed stay gists: at most 400 characters.
# 3. Staged suite code (demo/, tests/) must keep the offline suite green.
# 4. No commit is authored or committed by a test identity (@example.com).
# 5. No staged line adds an API key (Groq, Google, xAI, OpenAI-style); keys live in git-ignored files only.
# 6. Staged Python passes `ruff check` and `ruff format --check` (ruff.toml).
set -eu
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0
branch="$(git rev-parse --abbrev-ref HEAD)"
fail=0

for ident in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  if printf '%s\n' "$ident" | grep -qE '@example\.(com|org|net)>'; then
    echo "pre-commit: test identity '${ident% * *}' would author this commit; fix user.name/user.email in git config." >&2
    fail=1
  fi
done

keys='(gsk_[A-Za-z0-9]{30,}|AIza[0-9A-Za-z_-]{30,}|AQ\.[A-Za-z0-9_-]{30,}|xai-[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{30,})'
printf '%s\n' "$staged" | while IFS= read -r f; do
  if git diff --cached -U0 -- "$f" | grep '^+' | grep -v '^+++' | grep -qE "$keys"; then
    echo "pre-commit: $f adds what looks like an API key; keep keys in a git-ignored file (.secrets/, MemState/.env)." >&2
    exit 1
  fi
done || fail=1

if [ "$branch" != "main" ] && printf '%s\n' "$staged" | grep -q '^docs/report/'; then
  echo "pre-commit: docs/report/ is edited only on main (this branch: $branch)." >&2
  fail=1
fi

for map in $(printf '%s\n' "$staged" | grep -E '^\.scratch/[^/]+/map\.md$' || true); do
  long="$(git diff --cached -U0 -- "$map" | grep '^+' | grep -v '^+++' | awk 'length($0) > 401 { print length($0) - 1 }')"
  if [ -n "$long" ]; then
    echo "pre-commit: $map has added lines over 400 characters ($(echo $long | tr '\n' ' ')chars)." >&2
    echo "  Keep map lines a one-sentence gist + link; detail goes in the ticket's Answer." >&2
    fail=1
  fi
done

if printf '%s\n' "$staged" | grep -qE '^(demo|tests)/' && [ -d tests ] && [ -d demo ]; then
  py="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/.venv/bin/python"
  if ! "$py" -m pytest -q >/tmp/pre-commit-pytest.$$ 2>&1; then
    tail -n 20 /tmp/pre-commit-pytest.$$ >&2
    echo "pre-commit: offline suite is red; full log /tmp/pre-commit-pytest.$$" >&2
    fail=1
  else
    rm -f /tmp/pre-commit-pytest.$$
  fi
fi

py_staged="$(printf '%s\n' "$staged" | grep -E '\.py$' || true)"
if [ -n "$py_staged" ] && [ -f ruff.toml ]; then
  ruff="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/.venv/bin/ruff"
  if [ ! -x "$ruff" ]; then
    echo "pre-commit: $ruff is missing; install it: uv pip install -p .venv ruff" >&2
    fail=1
  elif ! printf '%s\n' "$py_staged" | xargs "$ruff" check --quiet || ! printf '%s\n' "$py_staged" | xargs "$ruff" format --check --quiet; then
    echo "pre-commit: ruff refuses the staged Python; run: .venv/bin/ruff check --fix . && .venv/bin/ruff format ." >&2
    fail=1
  fi
fi

exit "$fail"
